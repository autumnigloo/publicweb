{
  "name": "URL Opener",
  "short_name": "URL Opener",
  "description": "Reads a URL from clipboard or share, strips query args, prepends a prefix, and opens it.",
  "start_url": "/url-opener/",
  "scope": "/url-opener/",
  "display": "standalone",
  "background_color": "#0f0f13",
  "theme_color": "#0f0f13",
  "icons": [
    {
      "src": "icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/url-opener/",
    "method": "GET",
    "params": {
      "url":   "url",
      "text":  "text",
      "title": "title"
    }
  }
}
