{
  "name": "@Audio Transcribe",
  "short_name": "@Transcribe",
  "description": "Share an audio recording and get a Groq Whisper transcript.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f0f13",
  "theme_color": "#0f0f13",
  "icons": [
    {
      "src": "icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "share-audio",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            "audio/mp4",
            "audio/x-m4a",
            "audio/m4a",
            "audio/aac",
            "audio/mpeg",
            "audio/wav",
            "audio/ogg",
            "audio/webm",
            ".m4a",
            ".mp3",
            ".aac",
            ".wav",
            ".ogg",
            ".webm",
            ".flac",
            ".mp4"
          ]
        }
      ]
    }
  }
}
